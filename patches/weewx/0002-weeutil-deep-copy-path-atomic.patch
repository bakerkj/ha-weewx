# weeutil.weeutil.deep_copy_path is called by weewx.CopyGenerator.run (in
# weewx.reportengine) once per non-directory source path when copying skin
# assets into HTML_ROOT. The stock implementation does
#
#     os.unlink(dest_file)
#     shutil.copyfile(path, dest_file)
#
# so between the unlink and the last write the destination is missing, then
# empty or partial. A concurrent reader — the addon's nginx serving
# public_html/ — can hit that URL in the window, get a 404 or a truncated
# body, and cache it.
#
# In steady state the CopyGenerator only re-copies files matched by the skin's
# `copy_always` list (usually short — dynamically rendered assets), but at every
# `first_run` (fresh weewxd startup, first StdReportEngine invocation) it also
# re-copies every `copy_once` entry, typically the entire skin asset tree
# (CSS, JS, fonts, icons). During that pass an ingress HTTP request for a
# static asset can miss or drop bytes.
#
# Fix: write to a same-directory temp file (`tempfile.mkstemp` in the
# destination dir, so the rename is guaranteed intra-filesystem) then
# `os.replace`, which is atomic on POSIX. os.replace needs no write permission
# on an existing destination, so a file first copied from a read-only source
# (the case stock's unlink handles) is still overwritten on later runs.
# `shutil.copymode` gives the destination the source's mode, since mkstemp
# creates files 0600 and nginx must be able to read them. mtime is
# deliberately NOT copied, so downstream rsync/ftp sees a "new" file per
# report cycle.
#
# The stray-tmp cleanup uses `except BaseException` (not `Exception`) so a
# KeyboardInterrupt/SystemExit during a copy still unlinks the `.weewx-tmp-*`
# fragment before re-raising. A hard-kill (SIGKILL/OOM/power loss) can still
# leave a `.weewx-tmp-*` file in the destination directory — the leading `.`
# keeps them out of autoindex listings and no in-repo caller guesses the
# pathname, but nginx would serve one if asked by name. The bundled
# `user.refresh_stale_outputs` StdService walks every enabled StdReport's
# HTML_ROOT on `weewx.STARTUP` and sweeps every `.weewx-tmp-*` fragment as
# part of its existing stale-output-aging pass, so the fragment survives at
# most until the next weewxd start.
#
# Semantic difference vs. stock: a read-only source yields a read-only
# destination (stock's copyfile leaves the default mode). That is harmless
# here because the next copy replaces the file rather than writing into it.
# As with stock's unlink, a destination that was a symlink or hardlink
# becomes a plain, independent file. Stock skins ship regular files, so no
# in-tree caller is affected.
--- a/weeutil/weeutil.py
+++ b/weeutil/weeutil.py
@@ -19,6 +19,7 @@
 import os
 import re
 import shutil
+import tempfile
 import time
 from collections import ChainMap
 from contextlib import contextmanager
@@ -1885,17 +1886,25 @@
         # Make the destination directory:
         os.makedirs(d, exist_ok=True)
         dest_file = os.path.join(d, os.path.basename(path))
-        # Remove any existing destination file first in case it was previously
-        # copied from a read-only source (such as an immutable package store),
-        # which would otherwise cause open(dest_file, 'wb') to fail with
-        # PermissionError:
+        # Atomic copy: write a same-directory temp file, then os.replace it
+        # over dest_file. A concurrent reader (nginx serving public_html/)
+        # sees either the old file or the complete new one, never a missing
+        # or partial file. os.replace needs no write permission on an
+        # existing dest_file, so a copy from a read-only source can still be
+        # overwritten on a later run. mtime is not copied, so downstream
+        # rsync/ftp sees a new file each report cycle.
+        tmp_fd, tmp_path = tempfile.mkstemp(dir=d, prefix=".weewx-tmp-")
         try:
-            os.unlink(dest_file)
-        except (FileNotFoundError, OSError):
-            pass
-        # copyfile copies contents without propagating read-only file permissions
-        # and without preserving mtime:
-        shutil.copyfile(path, dest_file)
+            with os.fdopen(tmp_fd, "wb") as fdst, open(path, "rb") as fsrc:
+                shutil.copyfileobj(fsrc, fdst)
+            shutil.copymode(path, tmp_path)
+            os.replace(tmp_path, dest_file)
+        except BaseException:
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+            raise
         ncopy += 1
     return ncopy
 
