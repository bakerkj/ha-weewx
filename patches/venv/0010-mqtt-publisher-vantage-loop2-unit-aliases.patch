# felddy (felddy/weewx-home-assistant v1.2.1) registers unit groups for
# Vantage observations that weewx's obs_group_dict lacks (MISSING_OBS_GROUPS,
# applied with setdefault at startup). Add the Davis Vantage LOOP2 fields it
# still misses: windSpeed2, windGust10, windGustDir10, rain15 and
# pressure_raw. weewx 5.5.2 maps only windSpeed10 and windGustDir. Without a
# group, getStandardUnitType returns no unit, felddy publishes discovery with
# unit_of_measurement=None, and HA rejects the unit for the device class.
# Registering the group also lets weewx convert these values when the
# station's unit system differs from the target.
#
# felddy is a pip package in the venv, so this patch is applied to the
# weewx_ha package dir (see venv/ in patches/README.md).
--- a/utils.py
+++ b/utils.py
@@ -20,8 +20,13 @@
 MISSING_OBS_GROUPS: dict[str, str] = {
     "dayET": "group_rain",
     "monthET": "group_rain",
+    "pressure_raw": "group_pressure",
+    "rain15": "group_rain",
     "sunrise": "group_time",
     "sunset": "group_time",
+    "windGust10": "group_speed",
+    "windGustDir10": "group_direction",
+    "windSpeed2": "group_speed",
     "yearET": "group_rain",
 }
 
