# felddy (felddy/weewx-home-assistant v1.2.1) maps weewx unit names to HA
# unit_of_measurement strings via UNIT_METADATA in utils.py. HA drops the
# discovery message (entity stays unavailable) when the unit isn't valid for
# the entity's device_class. Checked against HA's DEVICE_CLASS_UNITS
# (HA 2026.1.3):
#
#   - 'cm_per_hour' (rainRate, snowRate; METRIC): felddy maps it to 'cm/h',
#     which precipitation_intensity rejects. Map to 'mm/h' and scale x10.
#   - 'mile' (windrun, lightning_distance; US): missing; HA wants 'mi'.
#   - 'microgram_per_meter_cubed' (pm1_0, pm2_5, pm10_0): missing; HA wants
#     'μg/m³'.
#
# Not fixed here: o3/so2 emit 'ppm' (HA accepts only 'μg/m³'), and rms/vecavg
# emit squared-time units ('_per_hour2').
#
# felddy is a pip package in the venv, so this patch is applied to the
# weewx_ha package dir (see venv/ in patches/README.md).
--- a/utils.py
+++ b/utils.py
@@ -146,8 +146,8 @@
 UNIT_METADATA: dict[str, dict[str, Optional[str]]] = {
     "cm": {"unit_of_measurement": "cm", "value_template": "{{ value | round(2) }}"},
     "cm_per_hour": {
-        "unit_of_measurement": "cm/h",
-        "value_template": "{{ value | round(2) }}",
+        "unit_of_measurement": "mm/h",
+        "value_template": "{{ (value | float * 10) | round(2) }}",
     },
     "degree_C": {
         "unit_of_measurement": "°C",
@@ -208,6 +208,11 @@
         "unit_of_measurement": "m/s",
         "value_template": "{{ value | round(1) }}",
     },
+    "microgram_per_meter_cubed": {
+        "unit_of_measurement": "μg/m³",
+        "value_template": "{{ value | round(2) }}",
+    },
+    "mile": {"unit_of_measurement": "mi", "value_template": "{{ value | round(2) }}"},
     "mile_per_hour": {
         "unit_of_measurement": "mph",
         "value_template": "{{ value | round(1) }}",
