+    def _emit_tick(self):
+        """Emit a synthetic gauge-data.txt write using cached values
+        with the current time as dateTime. Called from the run loop's
+        queue.Empty branch when tick_interval seconds have elapsed since
+        the last write. No buffer/cache mutation — read-only re-render.
+        """
+        # Wait until at least one real LOOP packet has been digested into
+        # self.buffer. calculate() reads running aggregates off
+        # self.buffer[source]; an empty buffer (pre-first-LOOP startup)
+        # raises KeyError out of get_field_value's aggregate branch for
+        # any derived obs (e.g. appTemp from StdWXCalculate). The buffer
+        # becomes non-empty as soon as process_new_loop_packet ingests
+        # the first LOOP. See 0014 header for the full rationale.
+        if not self.buffer:
+            return
+        # ts is rounded to the nearest integer second so timeUTC
+        # matches the LOOP-packet rounding (weewx Vantage stamps
+        # `packet['dateTime'] = int(time.time() + 0.5)`). Without
+        # matching rounding, _emit_tick's float ts is truncated by
+        # strftime("%S") while the LOOP write a moment earlier was
+        # rounded up — both end up with the same integer-second
+        # timeUTC, so the clock advances 2s at a time, not 1s.
+        #
+        # last_write must stay on the un-rounded wall clock so the
+        # tick-interval scheduler doesn't see a future timestamp when
+        # ts rounds up (which would make the next `time.time() -
+        # last_write` underflow tick_interval and skip a tick — the
+        # same 2-second symptom in a different layer).
+        now = time.time()
+        ts = int(now + 0.5)
+        cached_packet = self.packet_cache.get_packet(ts, self.max_cache_age)
+        self.lost_contact_flag = self.get_lost_contact(cached_packet, 'loop')
+        try:
+            data = self.calculate(cached_packet)
+        except Exception:
+            weeutil.logger.log_traceback(log.info, 'rtgdthread: **** ')
+            return
+        try:
+            self.write_data(data)
+        except Exception:
+            weeutil.logger.log_traceback(log.info, 'rtgdthread: **** ')
+            return
+        self.last_write = now
+        if self.exporter:
+            self.exporter.export(data, ts)
+
