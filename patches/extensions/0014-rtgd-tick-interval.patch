# rtgd's gauge-data.txt is written from process_packet(), which only fires when
# a new LOOP packet arrives in the queue. Davis ISS sends a packet every ~2.5s,
# so consumers (e.g. gauges.js polling gauge-data.txt) see the dateTime field
# stall in that interval and the displayed clock visibly catches up in jumps.
#
# Add an optional `tick_interval` rtgd config knob: when > 0, the run loop's
# existing 1-second control_queue timeout branch emits a synthetic write using
# the last cached values with dateTime advanced to time.time(). Sensor values
# stay at their most recent LOOP value; only the clock advances. Default
# disabled — set `tick_interval = 1` (in seconds) in weewx.conf
# [RealtimeGaugeData] to enable.
#
# Startup ordering: _emit_tick() builds gauge-data.txt by calling calculate()
# against the cached LOOP packet and reading running aggregates off
# self.buffer. self.buffer is primed lazily by process_new_loop_packet() as
# each LOOP packet arrives, so derived observations (e.g. appTemp computed
# by StdWXCalculate) aren't present until at least one full LOOP cycle has
# been digested. Without a gate, the first tick fires before that first
# LOOP and calculate() raises `KeyError: 'appTemp'` (or similar) out of
# get_field_value's aggregate branch. _emit_tick() short-circuits when
# self.buffer is empty — the buffer becomes non-empty as soon as
# process_new_loop_packet() ingests the first real LOOP, which is exactly
# the "wait for one LOOP packet" semantics we want.
--- a/bin/user/rtgd.py
+++ b/bin/user/rtgd.py
@@ -1487,6 +1487,16 @@
 
         # setup file generation timing
         self.min_interval = rtgd_config_dict.get('min_interval', None)
+        # tick_interval: when > 0, emit a synthetic gauge-data.txt
+        # write every tick_interval seconds even if no LOOP packet has
+        # arrived. Cached values are reused; dateTime advances to
+        # time.time() so consumers see a monotonically-rising clock.
+        _ti = rtgd_config_dict.get('tick_interval', None)
+        try:
+            _ti_f = float(_ti) if _ti not in (None, '') else 0.0
+        except (TypeError, ValueError):
+            _ti_f = 0.0
+        self.tick_interval = _ti_f if _ti_f > 0 else None
         self.last_write = 0  # ts (actual) of last generation
 
         # get our file paths and names
@@ -1801,8 +1811,11 @@
                         # received throw queue.Empty
                         _package = self.control_queue.get(True, 1.0)
                     except queue.Empty:
-                        # nothing in the queue so continue
-                        pass
+                        # no LOOP packet within 1s — emit a tick if enabled
+                        # so the gauge-data.txt clock advances.
+                        if (self.tick_interval is not None
+                                and (time.time() - self.last_write) >= self.tick_interval):
+                            self._emit_tick()
                     else:
