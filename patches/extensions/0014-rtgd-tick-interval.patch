+    def _emit_tick(self):
+        """Emit a synthetic gauge-data.txt write using cached values
+        with the current time as dateTime. Called from the run loop's
+        queue.Empty branch when tick_interval seconds have elapsed since
+        the last write. No buffer/cache mutation — read-only re-render.
+        """
+        # Round ts to the nearest integer second, matching how the
+        # weewx Vantage (and most other) drivers stamp LOOP packets:
+        # `packet['dateTime'] = int(time.time() + 0.5)`. Without this,
+        # _emit_tick's float ts is truncated by strftime("%S") while
+        # the LOOP write a fraction of a second earlier was rounded
+        # up — both end up with the same integer-second timeUTC, so
+        # the displayed clock advances 2s at a time instead of 1s.
+        ts = int(time.time() + 0.5)
+        cached_packet = self.packet_cache.get_packet(ts, self.max_cache_age)
+        self.lost_contact_flag = self.get_lost_contact(cached_packet, 'loop')
+        try:
+            data = self.calculate(cached_packet)
+        except Exception:
+            weeutil.logger.log_traceback(log.info, 'rtgdthread: **** ')
+            return
+        try:
+            self.write_data(data)
+        except Exception:
+            weeutil.logger.log_traceback(log.info, 'rtgdthread: **** ')
+            return
+        self.last_write = ts
+        if self.exporter:
+            self.exporter.export(data, ts)
+
