# Allow the [Rtldavis] config to set the raw -tr bitmask directly.
# The driver builds -tr from 5 named slots (iss/anemometer/leaf_soil/temp_hum_1
# /temp_hum_2), capping coverage at 5 of 8 transmitter IDs. For diagnostic
# scans (probing for nearby Davis stations on every channel) we want
# transmitters_override = 255.
--- a/bin/user/rtldavis.py
+++ b/bin/user/rtldavis.py
@@ -805,3 +805,5 @@
             channels['iss'], channels['anemometer'], channels['leaf_soil'],
             channels['temp_hum_1'], channels['temp_hum_2'])
+        _ov = stn_dict.get('transmitters_override')
+        if _ov is not None and str(_ov).strip(): self.transmitters = int(_ov); self.tr_count = bin(self.transmitters).count('1')
         loginf('using transmitters %d' % self.transmitters)
