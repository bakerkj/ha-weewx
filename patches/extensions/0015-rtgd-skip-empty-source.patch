# rtgd: skip emitting fields whose FieldMap source is empty.
#
# RealtimeGaugeDataThread.calculate() walks self.field_map and unconditionally
# writes every field into the JSON payload, falling back to a default value
# (or None) when the field's source observation is missing. There is no
# upstream way to *drop* a field from gauge-data.txt short of replacing the
# entire [[FieldMap]] block (~250 lines of config) — overriding `source =`
# to empty via [[FieldMapExtensions]] still emits the field as `null` or 0.
#
# Treat an empty/missing `source` in the merged field_map as "do not emit".
# This lets users prune the JSON via a small [[FieldMapExtensions]] override
# (`[[[inhum]]] source =`) instead of restating the full default field map.
#
# Two sites: the emit loop in calculate() (skip the field), AND the
# constructor's defaults-to-ValueTuple loop (skip entirely, otherwise
# _getUnitGroup('') -> None and self.units_dict[None] KeyErrors at boot
# before any LOOP packet has arrived).
--- a/bin/user/rtgd.py
+++ b/bin/user/rtgd.py
@@ -1592,6 +1592,13 @@
         # convert any defaults to ValueTuples
         for field in list(_field_map.items()):
             field_config = field[1]
+            # Operator may have pruned a field by setting its `source =`
+            # to empty in [[FieldMapExtensions]]; _getUnitGroup('') returns
+            # None which then KeyErrors self.units_dict[None]. Skip these
+            # entries entirely so the populate loop can skip them later
+            # (see 0015-rtgd-skip-empty-source.patch).
+            if not field_config.get('source'):
+                continue
             _group = _getUnitGroup(field_config['source'])
             _default = weeutil.weeutil.to_list(field_config.get('default', None))
             if _default is None:
@@ -2448,6 +2455,12 @@
 
         # now populate all fields in the field map
         for field in self.field_map:
+            # Operator can prune a field from gauge-data.txt by setting its
+            # `source =` to empty in [[FieldMapExtensions]]; skip emitting
+            # those fields rather than falling back to None / default. See
+            # 0015-rtgd-skip-empty-source.patch.
+            if not self.field_map[field].get('source'):
+                continue
             data[field] = self.get_field_value(field, packet)
         return data
 
