# rtgd: copy the field map into plain dicts before deep-copying it.
#
# RealtimeGaugeDataThread.__init__ merges FieldMap (default: the module
# global DEFAULT_FIELD_MAP) with FieldMapExtensions from weewx.conf, then
# copy.deepcopy()s the merged map. The weewx.conf entries are
# configobj.Section objects, which keep a reference to the whole config;
# deep-copying them runs configobj interpolation over the entire file and
# fails on the [Logging] formatter:
#
#   configobj.MissingInterpolationOption:
#       missing option "asctime" in interpolation.
#
# so the rtgd thread dies at startup on any station whose weewx.conf has
# that formatter and a FieldMap or FieldMapExtensions section.
#
# Build the merged map from dict() copies of each entry instead. The
# deepcopy then sees only plain dicts, and DEFAULT_FIELD_MAP and the
# config sections are never mutated, so a second __init__ in the same
# process (weewxd's engine retry loop) still sees the original defaults.
--- a/bin/user/rtgd.py
+++ b/bin/user/rtgd.py
@@ -1270,14 +1270,17 @@
         self.time_format = rtgd_config_dict.get('time_format', '%H:%M')
         self.flag_format = '%.0f'
         # Get the field map from our config, if it does not exist use the
-        # default. Use a deepcopy of the defaults as we will possibly be
-        # modifying the field map.
-        _field_map = rtgd_config_dict.get('FieldMap', copy.deepcopy(DEFAULT_FIELD_MAP))
+        # default. Copy each entry into a plain dict: a configobj section keeps
+        # a reference to the whole config, so the deepcopy below would
+        # otherwise interpolate unrelated options (e.g. %(asctime)s in
+        # [Logging]) and raise MissingInterpolationOption.
+        _src_map = rtgd_config_dict.get('FieldMap', DEFAULT_FIELD_MAP)
+        _field_map = {k: dict(_src_map[k]) for k in _src_map}

         # get any extensions
-        _extensions = rtgd_config_dict.get('FieldMapExtensions', {})
+        _src_ext = rtgd_config_dict.get('FieldMapExtensions', {})
         # and update the field map with the extensions
-        _field_map.update(_extensions)
+        _field_map.update({k: dict(_src_ext[k]) for k in _src_ext})
         # make a deepcopy of the extended field map as we will be iterating
         # over it and possibly making changes
         updated_field_map = copy.deepcopy(_field_map)
