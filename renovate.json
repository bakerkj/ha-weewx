{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6pm on friday"],
  "timezone": "America/New_York",
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Home Assistant add-on base images in Dockerfiles",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": [
        "[\\s=](?<depName>ghcr\\.io/home-assistant/[^:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "GitHub runner versions in shell scripts and YAML within workflows",
      "managerFilePatterns": ["/.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "runner=\"(?<depName>ubuntu|macos|windows)-(?<currentValue>[\\w.-]+)\"",
        "runs-on:\\s*(?<depName>ubuntu|macos|windows)-(?<currentValue>[\\w.-]+)"
      ],
      "datasourceTemplate": "github-runners"
    },
    {
      "customType": "regex",
      "description": "Renovate npm package version pinned in CI workflows",
      "managerFilePatterns": ["/.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["npx --package renovate@(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "APT packages pinned in Debian 13 (trixie) Dockerfiles, tracked against the Debian archive via the deb datasource (resolves binary package names directly — no per-package source mapping). depName excludes '_' since Debian package names can't contain underscores (avoids matching Python kwargs like 'exist_ok=True' in heredocs).",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": [
        "\\s+(?<depName>[a-z][a-z0-9+.-]*)=(?<currentValue>[\\w][\\w.:+~-]*)"
      ],
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb"
    },
    {
      "customType": "regex",
      "description": "Tag-pinned WeeWX deps from GitHub archive zips — bundled extensions in build/extensions.txt and the Dockerfile, and felddy's weewx_ha in pyproject.toml.",
      "managerFilePatterns": [
        "/Dockerfile$/",
        "/pyproject\\.toml$/",
        "/build/extensions\\.txt$/"
      ],
      "matchStrings": [
        "github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/archive/(?<currentValue>[vV]?\\d+(?:\\.\\d+)+)\\.zip"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "SHA-pinned WeeWX deps on default branch 'master'. None of these repos tag releases; tracked via git-refs against the branch HEAD. Renovate writes the full 40-char SHA on bump (GitHub archive URLs accept either 7 or 40). The companion rule below handles repos whose default branch is 'main'.",
      "managerFilePatterns": ["/Dockerfile$/", "/build/extensions\\.txt$/"],
      "matchStrings": [
        "github\\.com/(?<depName>matthewwall/weewx-emoncms)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>matthewwall/weewx-exfoliation)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>matthewwall/weewx-owm)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>matthewwall/weewx-thingspeak)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>matthewwall/weewx-wcloud)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>matthewwall/weewx-wetter)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>matthewwall/weewx-windfinder)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>claudobahn/weewx-windguru)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip",
        "github\\.com/(?<depName>tkeffer/weewx-xaggs)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip"
      ],
      "packageNameTemplate": "https://github.com/{{depName}}",
      "currentValueTemplate": "master",
      "datasourceTemplate": "git-refs",
      "autoReplaceStringTemplate": "github.com/{{depName}}/archive/{{newDigest}}.zip"
    },
    {
      "customType": "regex",
      "description": "SHA-pinned WeeWX deps on default branch 'main'. See the 'master' companion rule above for the rationale.",
      "managerFilePatterns": ["/Dockerfile$/", "/build/extensions\\.txt$/"],
      "matchStrings": [
        "github\\.com/(?<depName>chaunceygardiner/weewx-rain24h)/archive/(?<currentValue>)(?<currentDigest>[0-9a-f]{7,40})\\.zip"
      ],
      "packageNameTemplate": "https://github.com/{{depName}}",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "autoReplaceStringTemplate": "github.com/{{depName}}/archive/{{newDigest}}.zip"
    },
    {
      "customType": "regex",
      "description": "uv build tool, bind-mounted into the Dockerfile build (RUN --mount=from=ghcr.io/astral-sh/uv:<version>). Renovate's docker manager doesn't parse --mount=from, so it's matched here.",
      "managerFilePatterns": ["/Dockerfile$/"],
      "matchStrings": ["astral-sh/uv:(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "ghcr.io/astral-sh/uv",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "matchManagers": ["uv"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["/home-assistant/"],
      "groupName": "home-assistant base images"
    },
    {
      "description": "Resolve pinned Debian apt packages against the trixie archive (main + updates + security), matching the base-debian image's apt sources.",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
        "https://deb.debian.org/debian?suite=trixie-updates&components=main&binaryArch=amd64",
        "https://security.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64"
      ],
      "groupName": "apt packages"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-tags", "git-refs"],
      "groupName": "weewx extensions"
    },
    {
      "description": "rtgd's version is also baked into a hardcoded unzip PREFIX in the Dockerfile, so an automated URL bump would silently break the build. Track it manually via scripts/check-updates.sh.",
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["hoetzgit/weewx-realtime_gauge-data"],
      "enabled": false
    },
    {
      "description": "Pin Python to the 3.13 series — it must match python3 in the Debian trixie base image. Bumping to 3.14 makes uv build a standalone 3.14 venv that mismatches the base's apt python3 (broke the build). Lift this when the base moves to a Debian release with 3.14.",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.14"
    }
  ]
}
