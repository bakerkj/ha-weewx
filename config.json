{
  "name": "WeeWX",
  "slug": "weewx",
  "description": "WeeWX weather station server with bundled extensions. Edit /config/weewx.conf directly (on the host: /addon_configs/<slug>_weewx/weewx.conf).",
  "url": "https://github.com/bakerkj/ha-weewx",
  "image": "ghcr.io/bakerkj/{arch}-ha-weewx",
  "version": "0.1.31",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "services",
  "init": false,
  "usb": true,
  "udev": true,
  "host_network": true,
  "ingress": true,
  "panel_icon": "mdi:weather-partly-cloudy",
  "panel_title": "WeeWX",
  "map": [
    "addon_config:rw",
    "share:rw"
  ],
  "devices": [
    "/dev/ttyUSB0",
    "/dev/ttyUSB1",
    "/dev/ttyUSB2",
    "/dev/ttyS0",
    "/dev/ttyS1",
    "/dev/ttyACM0",
    "/dev/ttyACM1"
  ],
  "options": {
    "watchdog_path": "",
    "watchdog_max_age_seconds": 600,
    "watchdog_consecutive_failures": 3,
    "watchdog_interval_seconds": 30,
    "watchdog_startup_grace_seconds": 600
  },
  "schema": {
    "watchdog_path": "str?",
    "watchdog_max_age_seconds": "int(1,)",
    "watchdog_consecutive_failures": "int(1,)",
    "watchdog_interval_seconds": "int(1,)",
    "watchdog_startup_grace_seconds": "int(0,)"
  }
}
